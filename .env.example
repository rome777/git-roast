# ==============================================================================
# GitRoast Environment Variables
# ==============================================================================

# 1. PostgreSQL Database Connection (Local Postgres, Supabase, Neon, AWS RDS 등)
# 설정 시 PostgreSQL 엔진이 활성화되며, 미설정 시 내장 SQLite(data/gitroast.db)로 자동 동작합니다.
# 예시 1: 로컬 PostgreSQL: postgresql://postgres:비밀번호@localhost:5432/gitroast
# 예시 2: Supabase Pooler: postgresql://postgres.xxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# 2. Supabase Settings (Optional, 클라이언트 Auth 연동 시)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Google Gemini API (https://aistudio.google.com/)
# 미설정 시 내장 스마트 AI 제너레이터로 자동 동작
GEMINI_API_KEY=

# 4. GitHub Personal Access Token (Optional)
# 시간당 60회 초과 요청 처리용
GITHUB_TOKEN=

# 5. Session Cookie Signing Secret (필수)
# 세션 쿠키 위조를 막는 HMAC 서명 키. 32자 이상이어야 하며, 없으면 모든 인증이 실패합니다.
# 생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 이 값을 바꾸면 발급된 로그인 세션이 전부 무효화됩니다.
SESSION_SECRET=

# 6. App Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 7. 데모 계정 원클릭 로그인 차단 (운영 배포 시 true 권장)
DISABLE_DEMO_LOGIN=
