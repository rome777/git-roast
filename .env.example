# ==============================================================================
# GitRoast Environment Variables
# ==============================================================================

# 1. PostgreSQL Database Connection (Local Postgres, Supabase, Neon, AWS RDS 등)
# 설정 시 PostgreSQL 엔진이 활성화되며, 미설정 시 내장 SQLite(data/gitroast.db)로 자동 동작합니다.
# 예시 1: 로컬 PostgreSQL: postgresql://postgres:비밀번호@localhost:5432/gitroast
# 예시 2: Supabase Pooler: postgresql://postgres.xxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=

# 2. Supabase Settings (Optional, 클라이언트 Auth 연동 시)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Google Gemini API (https://aistudio.google.com/)
# 미설정 시 내장 스마트 AI 제너레이터로 자동 동작
GEMINI_API_KEY=

# 4. GitHub Personal Access Token (Optional)
# 시간당 60회 초과 요청 처리용
GITHUB_TOKEN=

# 5. Session Cookie Signing Secret (필수)
# 세션 쿠키 위조를 막는 HMAC 서명 키. 32자 이상이어야 하며, 없으면 모든 인증이 실패합니다.
# 생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 이 값을 바꾸면 발급된 로그인 세션이 전부 무효화됩니다.
SESSION_SECRET=

# 6. App Base URL
# ⚠️ NEXT_PUBLIC_ 접두사 변수는 빌드 시점에 코드에 박힌다. 배포 후 대시보드에서
# 값을 바꿔도 재배포 전에는 반영되지 않는다. 공유 링크 메타태그의 기준 주소.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 7. 데모 계정 원클릭 로그인 차단 (운영 배포 시 true 권장)
DISABLE_DEMO_LOGIN=

# 8. 요청량 제한 (선택 — 미설정 시 아래 기본값)
# /api/analyze 는 호출마다 Gemini 추론 비용이 발생하고 비로그인으로도 호출된다.
# 카운터는 DB(rate_limits 테이블)에 두므로 별도 Redis 가 필요 없다.
RATE_LIMIT_GUEST_HOUR=3     # 비로그인 IP 당 시간
RATE_LIMIT_GUEST_DAY=10     # 비로그인 IP 당 하루
RATE_LIMIT_USER_HOUR=10     # 로그인 사용자 IP 당 시간 (다계정 남용 방지)
RATE_LIMIT_USER_DAY=30      # 계정 당 하루
RATE_LIMIT_GLOBAL_DAY=500   # 전역 킬스위치 — 하루 총량. 비용 폭주를 막는 최후 방어선

# 인증 엔드포인트(로그인/가입) 제한.
# 없으면 비밀번호를 무한히 추측할 수 있고 계정을 무제한으로 만들 수 있다.
RATE_LIMIT_AUTH_MINUTE=5           # IP 당 분
RATE_LIMIT_AUTH_HOUR=20            # IP 당 시간
RATE_LIMIT_LOGIN_ACCOUNT_HOUR=20   # 대상 계정 당 시간 (분산 IP 공격 대비)
RATE_LIMIT_RESEND_ACCOUNT_HOUR=3   # 확인 메일 재발송, 대상 주소 당 시간 (메일 폭탄 방지)

# 9. 세션 쿠키 secure 플래그 (선택)
# 미설정 시 NODE_ENV=production 이면 자동으로 켜진다.
# 로컬에서 프로덕션 빌드를 http 로 확인할 때만 false 로 둔다.
COOKIE_SECURE=

# 10. 데이터 이관 (scripts/migrate-postgres-to-postgres.mjs)
# npm run db:copy 의 원본/대상. --from / --to 인자로도 줄 수 있다.
# 원본을 비우면 위의 DATABASE_URL 을 원본으로 쓴다.
SOURCE_DATABASE_URL=
TARGET_DATABASE_URL=

# 11. DB 폴백 정책 (선택)
# DATABASE_URL 접속에 실패했을 때 SQLite 로 조용히 넘어갈지.
# 미설정 시 NODE_ENV=production 이면 폴백하지 않고 에러를 올린다.
# (운영에서 폴백하면 데이터가 인스턴스 로컬에 쌓이다 재배포 때 사라진다)
DB_STRICT=

# 12. 이메일 확인 (보안 수칙 2번)
# RESEND_API_KEY 와 MAIL_FROM 이 **둘 다** 있어야 메일을 보낸다.
# https://resend.com 에서 키를 만들고, 보내는 주소의 도메인을 인증해야 한다.
# MAIL_FROM 예: GitRoast <noreply@내도메인.com>
RESEND_API_KEY=
MAIL_FROM=
#
# 확인 안 된 계정의 로그인 차단 여부: true / false / (비움 = auto)
# auto 는 "메일을 실제로 보낼 수 있을 때만 강제" 다. 메일 설정 없이 강제하면
# 확인 링크를 받을 방법이 없어 아무도 로그인할 수 없다.
REQUIRE_EMAIL_VERIFICATION=

# 13. CAPTCHA — Cloudflare Turnstile (보안 수칙 4번)
# 두 값이 **모두** 있을 때만 켜진다. 한쪽만 있으면 검사를 건너뛰고 경고를 남긴다.
# https://dash.cloudflare.com → Turnstile 에서 사이트를 만들면 두 값이 나온다.
# ⚠️ NEXT_PUBLIC_ 접두사라 사이트 키는 **빌드 시점에 박힌다.** 값을 넣은 뒤 재배포해야 위젯이 뜬다.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 14. 비밀번호 유출 검사 (보안 수칙 3번)
# 기본으로 켜져 있다. HaveIBeenPwned k-익명성 API 라 비밀번호 원문은 나가지 않는다.
# DISABLE_PWNED_CHECK=true 로 끌 수 있고, PWNED_MAX_COUNT 는 허용 유출 횟수(기본 0).
DISABLE_PWNED_CHECK=
PWNED_MAX_COUNT=

# 15. 그 외 코드가 읽는 변수
# POSTGRES_URL : DATABASE_URL 의 대체 이름. 둘 중 하나만 있으면 된다.
# SITE_URL     : NEXT_PUBLIC_SITE_URL 이 비었을 때의 서버 전용 대체값.
#                NEXT_PUBLIC_ 과 달리 빌드 시점에 각인되지 않는다.
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL : Vercel 이 자동 주입한다. 직접 넣지 않는다.
